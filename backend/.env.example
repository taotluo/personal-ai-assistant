# 复制为 .env 并按需修改；环境变量同名覆盖（前缀 PAA_）

# WS 认证令牌（公网部署前必须改掉默认值）
PAA_TOKEN=dev-token

# 智谱 API key（https://open.bigmodel.cn）；留空且 PAA_LLM=zhipu 时启动会报错
PAA_ZHIPU_API_KEY=

# ── 或：任何 OpenAI 兼容 API（DeepSeek/Kimi/Qwen/OpenAI/Ollama/vLLM/one-api 网关）──
# 把 PAA_LLM 改为 openai 并填：
# PAA_LLM=openai
# PAA_OPENAI_API_KEY=sk-xxxx
# PAA_OPENAI_BASE_URL=https://api.deepseek.com/v1    # 按厂商/网关改
# PAA_MODEL_STRONG=deepseek-chat                      # 模型名也改成对应厂商的
# PAA_MODEL_FAST=deepseek-chat
# 示例：
#   Kimi:      base_url=https://api.moonshot.cn/v1           model=moonshot-v1-128k
#   Qwen兼容:  base_url=https://dashscope.aliyuncs.com/compatible-mode/v1  model=qwen-max
#   Ollama本地: base_url=http://localhost:11434/v1            key=ollama  model=qwen2.5:14b
#   智谱兼容:  base_url=https://open.bigmodel.cn/api/paas/v4/  model=glm-4.6

# 分级模型：规划/审核/总结用强模型，简单子任务用便宜档（按你账号可用型号调整）
PAA_MODEL_STRONG=glm-4.6
PAA_MODEL_FAST=glm-4.5-flash

# LLM 后端：zhipu | openai | mock（无 key 冒烟用）
# PAA_LLM=mock

# 监听地址；本机开发保持 127.0.0.1，云部署改 0.0.0.0 并套 TLS
# PAA_HOST=127.0.0.1
# PAA_PORT=8600

# 单个子任务最长执行秒数
# PAA_AGENT_TIMEOUT=600

# 每个子任务自动重试次数上限（执行失败 + 审核不通过共用预算）
# PAA_MAX_RETRIES=2

# 审核-重跑循环轮数上限
# PAA_MAX_REVIEW_ROUNDS=2
